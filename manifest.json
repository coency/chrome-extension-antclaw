{
  "manifest_version": 3,
  "name": "爬爬蚁",
  "version": "1.4.3",
  "description": "多平台创作者数据中心导出 CSV：抖音、视频号、哔哩哔哩。自然周/月汇总、作品明细与封面；B站作品按发布日期筛选累计数据。",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "爬爬蚁"
  },
  "permissions": [
    "downloads",
    "storage",
    "notifications",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://creator.douyin.com/*",
    "https://*.douyinpic.com/*",
    "https://channels.weixin.qq.com/*",
    "https://finder.video.qq.com/*",
    "https://member.bilibili.com/*",
    "https://i0.hdslb.com/*",
    "https://i1.hdslb.com/*",
    "https://i2.hdslb.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://creator.douyin.com/*",
        "https://channels.weixin.qq.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://member.bilibili.com/*"
      ],
      "js": [
        "bilibili.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
